+            score: Some(-0.72),
+            threshold: Some(0.5),
+        };
+        log.append(
+            RoutingLogContext::from_headers(&headers)
+                .with_route(Some("auto"))
+                .with_decision_evidence(Some(&evidence)),
+            "combo-normal",
+            Some("weak"),
+            &Usage {
+                input_tokens: Some(12),
+                output_tokens: Some(4),
+                ..Usage::default()
+            },
+        )
+        .expect("append record");
+
+        let record: serde_json::Value =
+            serde_json::from_str(&fs::read_to_string(path).expect("read routing log"))
+                .expect("parse routing record");
+        assert_eq!(record["route"], "auto");
+        assert_eq!(record["decision_source"], "dimensions");
+        assert_eq!(record["decision_score"], -0.72);
+        assert_eq!(record["decision_threshold"], 0.5);
+        assert_eq!(record["model"], "combo-normal");
+        assert_eq!(record["tier"], "weak");
+        assert_eq!(record["prompt_tokens"], 12);
+        assert_eq!(record["completion_tokens"], 4);
