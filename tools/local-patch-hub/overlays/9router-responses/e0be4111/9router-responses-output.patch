@@ -0,0 +1,13 @@
+import { describe, expect, it } from "vitest";
+import { CodexExecutor } from "../../open-sse/executors/codex.js";
+
+describe("CodexExecutor compact routing", () => {
+  it("selects compact endpoint from current request without stale executor state", () => {
+    const executor = new CodexExecutor();
+    const credentials = {};
+
+    expect(executor.buildUrl("gpt-5.6-sol", true, 0, credentials, { _compact: true })).toMatch(/\/compact$/);
+    expect(executor.buildUrl("gpt-5.6-sol", true, 0, credentials, {})).not.toMatch(/\/compact$/);
+    expect(executor.buildUrl("gpt-5.6-sol", true, 0, credentials, { _compact: true })).toMatch(/\/compact$/);
+  });
+});
diff --git a/tests/unit/responses-stream-error-preservation.test.js b/tests/unit/responses-stream-error-preservation.test.js
new file mode 100644
index 00000000..4ea8fa4c
--- /dev/null
+++ b/tests/unit/responses-stream-error-preservation.test.js
@@ -0,0 +1,130 @@
+import { describe, expect, it } from "vitest";
+
+import { FORMATS } from "../../open-sse/translator/formats.js";
+import { createResponsesApiTransformStream } from "../../open-sse/transformer/responsesTransformer.js";
+import { convertResponsesStreamToJson } from "../../open-sse/transformer/streamToJsonConverter.js";
+import { createSSETransformStreamWithLogger } from "../../open-sse/utils/stream.js";
+
+async function runTransform(input) {
+  const encoder = new TextEncoder();
+  const stream = new ReadableStream({
+    start(controller) {
+      controller.enqueue(encoder.encode(input));
+      controller.close();
+    },
+  });
+
+  const output = stream.pipeThrough(
+    createSSETransformStreamWithLogger(
+      FORMATS.OPENAI_RESPONSES,
+      FORMATS.OPENAI_RESPONSES,
+      "codex",
+      null,
+      null,
+      "gpt-5.5",
+    ),
+  );
+  const reader = output.getReader();
+  const decoder = new TextDecoder();
+  let text = "";
+
+  while (true) {
+    const { value, done } = await reader.read();
+    if (done) break;
+    text += decoder.decode(value, { stream: true });
+  }
+
+  return text + decoder.decode();
+}
+
+async function runResponsesTransformer(input) {
+  const encoder = new TextEncoder();
+  const stream = new ReadableStream({
+    start(controller) {
+      controller.enqueue(encoder.encode(input));
+      controller.close();
+    },
+  });
+  const output = stream.pipeThrough(createResponsesApiTransformStream());
+  const reader = output.getReader();
+  const decoder = new TextDecoder();
+  let text = "";
+
+  while (true) {
+    const { value, done } = await reader.read();
+    if (done) break;
+    text += decoder.decode(value, { stream: true });
+  }
+
+  return text + decoder.decode();
+}
+
+function responseErrorStream() {
+  const encoder = new TextEncoder();
+  return new ReadableStream({
+    start(controller) {
+      controller.enqueue(encoder.encode([
+        "event: error",
+        `data: ${JSON.stringify({
+          type: "error",
+          error: {
+            type: "internal_error",
+            message: "response protection is unavailable",
+          },
+        })}`,
+        "",
+        "",
+      ].join("\n")));
+      controller.close();
+    },
+  });
+}
+
+describe("OpenAI Responses upstream errors", () => {
+  it("preserves error event and diagnostic payload from HTTP 200 SSE", async () => {
+    const output = await runTransform([
+      "event: error",
+      `data: ${JSON.stringify({
+        type: "error",
+        error: {
+          type: "internal_error",
+          message: "response protection is unavailable",
+        },
+      })}`,
+      "",
+      "",
+    ].join("\n"));
+
+    expect(output).toContain("event: error");
+    expect(output).toContain('"message":"response protection is unavailable"');
+    expect(output).not.toContain("event: response.failed");
+    expect(output).not.toContain("[Empty streaming response]");
+  });
+
+  it("does not convert upstream error SSE into completed empty Responses output", async () => {
+    const output = await runResponsesTransformer([
+      `data: ${JSON.stringify({
+        type: "error",
+        error: {
+          type: "internal_error",
+          message: "response protection is unavailable",
+        },
+      })}`,
+      "",
+      "",
+    ].join("\n"));
+
+    expect(output).toContain('"message":"response protection is unavailable"');
+    expect(output).not.toContain("event: response.completed");
+  });
+
+  it("returns failed JSON with upstream error details for non-streaming clients", async () => {
+    const output = await convertResponsesStreamToJson(responseErrorStream());
+
+    expect(output.status).toBe("failed");
+    expect(output.error).toEqual({
+      type: "internal_error",
+      message: "response protection is unavailable",
+    });
+  });
+});
diff --git a/tests/unit/responses-transformer-completed-output.test.js b/tests/unit/responses-transformer-completed-output.test.js
new file mode 100644
index 00000000..b65ef0dd
--- /dev/null
+++ b/tests/unit/responses-transformer-completed-output.test.js
@@ -0,0 +1,55 @@
+import { describe, expect, it } from "vitest";
+
+import { createResponsesApiTransformStream } from "../../open-sse/transformer/responsesTransformer.js";
+
+async function runTransform(input) {
+  const encoder = new TextEncoder();
+  const stream = new ReadableStream({
+    start(controller) {
+      controller.enqueue(encoder.encode(input));
+      controller.close();
+    },
+  });
+
+  const output = stream.pipeThrough(createResponsesApiTransformStream());
+  const reader = output.getReader();
+  const decoder = new TextDecoder();
+  let text = "";
+
+  while (true) {
+    const { value, done } = await reader.read();
+    if (done) break;
+    text += decoder.decode(value, { stream: true });
+  }
+
+  return text + decoder.decode();
+}
+
+describe("Responses API completion events", () => {
+  it("includes an output array in response.completed", async () => {
+    const output = await runTransform([
+      "data: " + JSON.stringify({
+        id: "chatcmpl_test",
+        choices: [{
+          index: 0,
+          delta: { content: "done" },
+          finish_reason: "stop",
+        }],
+      }),
+      "",
+      "",
+    ].join("\n"));
+
+    const completed = output
+      .split("\n\n")
+      .find((event) => event.startsWith("event: response.completed"));
+    const payload = JSON.parse(completed.split("data: ")[1]);
+
+    expect(payload.response.output).toEqual([{
+      id: "msg_resp_chatcmpl_test_0",
+      type: "message",
+      content: [{ type: "output_text", annotations: [], logprobs: [], text: "done" }],
+      role: "assistant",
+    }]);
+  });
+});
