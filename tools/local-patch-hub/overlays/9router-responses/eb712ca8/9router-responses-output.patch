diff --git a/tests/unit/openai-responses-completed-output-passthrough.test.js b/tests/unit/openai-responses-completed-output-passthrough.test.js
new file mode 100644
index 00000000..2e26c7aa
--- /dev/null
+++ b/tests/unit/openai-responses-completed-output-passthrough.test.js
@@ -0,0 +1,57 @@
+import { describe, expect, it } from "vitest";
+
+import { FORMATS } from "../../open-sse/translator/formats.js";
+import { createSSETransformStreamWithLogger } from "../../open-sse/utils/stream.js";
+
+async function runTransform(input) {
+  const encoder = new TextEncoder();
+  const stream = new ReadableStream({
+    start(controller) {
+      controller.enqueue(encoder.encode(input));
+      controller.close();
+    },
+  });
+
+  const output = stream.pipeThrough(createSSETransformStreamWithLogger(
+    FORMATS.OPENAI_RESPONSES,
+    FORMATS.OPENAI_RESPONSES,
+    "codex",
+  ));
+  const reader = output.getReader();
+  const decoder = new TextDecoder();
+  let text = "";
+
+  while (true) {
+    const { value, done } = await reader.read();
+    if (done) break;
+    text += decoder.decode(value, { stream: true });
+  }
+
+  return text + decoder.decode();
+}
+
+describe("Native Responses completion events", () => {
+  it("reconstructs response.completed.response.output from output items", async () => {
+    const item = {
+      id: "msg_resp_test_0",
+      type: "message",
+      content: [{ type: "output_text", annotations: [], logprobs: [], text: "done" }],
+      role: "assistant",
+    };
+    const output = await runTransform([
+      "event: response.output_item.done",
+      `data: ${JSON.stringify({ type: "response.output_item.done", output_index: 0, item })}`,
+      "",
+      "event: response.completed",
+      `data: ${JSON.stringify({ type: "response.completed", response: { id: "resp_test", output: null } })}`,
+      "",
+    ].join("\n"));
+
+    const completed = output
+      .split("\n\n")
+      .find((event) => event.startsWith("event: response.completed"));
+    const payload = JSON.parse(completed.split("data: ")[1]);
+
+    expect(payload.response.output).toEqual([item]);
+  });
+});
diff --git a/tests/unit/openai-responses-completed-output.test.js b/tests/unit/openai-responses-completed-output.test.js
new file mode 100644
index 00000000..5e216ab0
--- /dev/null
+++ b/tests/unit/openai-responses-completed-output.test.js
@@ -0,0 +1,27 @@
+import { describe, expect, it } from "vitest";
+
+import { initState } from "../../open-sse/translator/index.js";
+import { openaiToOpenAIResponsesResponse } from "../../open-sse/translator/response/openai-responses.js";
+
+describe("OpenAI Responses completion events", () => {
+  it("includes finalized output items in response.completed", () => {
+    const state = initState("openai-responses");
+    const events = openaiToOpenAIResponsesResponse({
+      id: "chatcmpl_test",
+      choices: [{
+        index: 0,
+        delta: { content: "done" },
+        finish_reason: "stop",
+      }],
+    }, state);
+
+    const completed = events.find(({ event }) => event === "response.completed");
+
+    expect(completed.data.response.output).toEqual([{
+      id: "msg_resp_chatcmpl_test_0",
+      type: "message",
+      content: [{ type: "output_text", annotations: [], logprobs: [], text: "done" }],
+      role: "assistant",
+    }]);
+  });
+});
diff --git a/tests/unit/responses-transformer-completed-output.test.js b/tests/unit/responses-transformer-completed-output.test.js
