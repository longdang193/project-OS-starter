index 00000000..6531aa4f
--- /dev/null
+++ b/tools/cgw-codex-shim/compatibility.md
@@ -0,0 +1,32 @@
+# CGW / 9Router Compatibility Matrix
+
+Recorded on 2026-10-21 (Europe/Berlin) during the direct CGW transport gate.
+
+| Component | Observed value | Result |
+| --- | --- | --- |
+| Development checkout | current working tree | Direct CGW transport under test |
+| Installed 9Router | `9router-app` `0.5.104` | Running on `http://127.0.0.1:20128` |
+| CGW runtime | `codex-chatgpt-web` `6.1.12-win32-x64` | Responses bridge on `http://127.0.0.1:17841` |
+| Shim | `tools/cgw-codex-shim/run.js` | Chat Completions compatibility on `http://127.0.0.1:20129` |
+| CGW transport | Direct `POST /v1/responses` | Does not invoke `codex exec` or 9Router Codex provider |
+| Model selection | `gpt-5.6-sol`, `gpt-6.1-sol` | Alias target is sent unchanged to CGW |
+| Thinking override | `reasoning_effort=low|medium|high` | `low` becomes Responses `reasoning.effort=instant`; other values pass through |
+| Test validation | `POST /api/v1/chat/completions` with `hi` or an interactive multi-message context | Requires a real completion and matching returned model |
+
+## Root cause corrected
+
+The previous shim translated Chat Completions into `codex exec`, configured that
+child to call 9Router on port `20128`, and qualified targets as
+`codex/gpt-*`. That path selected a Codex OAuth connection and consumed Codex
+quota even though the public model prefix was `cgw`.
+
+The shim now translates directly to CGW's authenticated Responses bridge on
+port `17841`. It fails closed when no CGW bearer is configured, so it cannot
+silently fall back to native Codex execution.
+
+## Authentication
+
+CGW requires a valid native bearer in the incoming request. The shim accepts
+that bearer only from the local `CGW_SHIM_CGW_BEARER` environment variable or
+`CGW_SHIM_CGW_BEARER_FILE`. A regular `sk-*` API key is rejected by CGW and is
+not treated as a fallback.
diff --git a/tools/cgw-codex-shim/config.js b/tools/cgw-codex-shim/config.js
new file mode 100644
index 00000000..e5fb452b
--- /dev/null
+++ b/tools/cgw-codex-shim/config.js
@@ -0,0 +1,93 @@
+import "./env.js";
+
+const LOOPBACK_HOSTS = new Set(["127.0.0.1", "::1", "localhost"]);
+const DEFAULT_MAX_BODY_BYTES = 1024 * 1024;
+const DEFAULT_CGW_TIMEOUT_MS = 600000;
+
+function positiveInteger(value, name, { allowZero = false } = {}) {
+  const number = Number(value);
+  const minimum = allowZero ? 0 : 1;
+  if (!Number.isInteger(number) || number < minimum) {
+    throw new Error(`${name} must be an integer >= ${minimum}`);
+  }
+  return number;
+}
+
+function booleanValue(value, name, fallback) {
+  if (value == null || value === "") return fallback;
+  if (value === true || value === "true" || value === "1") return true;
+  if (value === false || value === "false" || value === "0") return false;
+  throw new Error(`${name} must be true or false`);
+}
+
+function requiredString(value, name) {
+  const result = String(value ?? "").trim();
+  if (!result) throw new Error(`${name} is required`);
+  return result;
+}
+
+function requiredLoopbackUrl(value, name) {
+  const result = requiredString(value, name);
+  let url;
+  try { url = new URL(result); } catch { throw new Error(`${name} must be a valid URL`); }
+  if (url.protocol !== "http:" || !LOOPBACK_HOSTS.has(url.hostname)) {
+    throw new Error(`${name} must be an http loopback URL`);
+  }
+  return result.replace(/\/$/, "");
+}
+
+export function parseModelAliases(raw) {
+  let parsed;
+  try {
+    parsed = typeof raw === "string" ? JSON.parse(raw) : raw;
+  } catch {
+    throw new Error("model aliases must be valid JSON");
+  }
+  if (!parsed || Array.isArray(parsed) || typeof parsed !== "object") {
+    throw new Error("model aliases must be an object");
+  }
+
+  const aliases = {};
+  for (const [alias, targetModel] of Object.entries(parsed)) {
+    if (!alias.trim() || /\s/.test(alias)) throw new Error("model alias must be non-empty and contain no whitespace");
+    const model = String(targetModel ?? "").trim();
+    if (!model) throw new Error(`target model for alias ${alias} is required`);
+    if (!model.startsWith("chatgpt-web/")) {
+      throw new Error(`CGW target model for alias ${alias} must use the chatgpt-web/ browser route`);
+    }
+    aliases[alias] = model;
+  }
+  if (!Object.keys(aliases).length) throw new Error("at least one model alias is required");
+  return Object.fromEntries(Object.entries(aliases).sort(([left], [right]) => left.localeCompare(right)));
+}
+
+export function loadConfig(env = process.env) {
+  const host = String(env.CGW_SHIM_HOST || "127.0.0.1").trim();
+  if (!LOOPBACK_HOSTS.has(host)) throw new Error("CGW_SHIM_HOST must be a loopback address");
+
+  const apiKey = requiredString(env.CGW_SHIM_API_KEY, "CGW_SHIM_API_KEY");
+  const modelAliases = parseModelAliases(env.CGW_SHIM_MODEL_ALIASES_JSON);
+  const port = positiveInteger(env.CGW_SHIM_PORT ?? "20129", "CGW_SHIM_PORT", { allowZero: true });
+  if (port > 65535) throw new Error("CGW_SHIM_PORT must be <= 65535");
+
+  const cgwBaseUrl = requiredLoopbackUrl(env.CGW_SHIM_CGW_BASE_URL || "http://127.0.0.1:17841/v1", "CGW_SHIM_CGW_BASE_URL");
+
+  return {
+    host,
+    port,
+    apiKey,
+    modelAliases,
+    limits: {
+      maxBodyBytes: positiveInteger(env.CGW_SHIM_MAX_BODY_BYTES ?? String(DEFAULT_MAX_BODY_BYTES), "CGW_SHIM_MAX_BODY_BYTES"),
+      maxConcurrent: positiveInteger(env.CGW_SHIM_MAX_CONCURRENT ?? "1", "CGW_SHIM_MAX_CONCURRENT"),
+      maxQueue: positiveInteger(env.CGW_SHIM_MAX_QUEUE ?? "8", "CGW_SHIM_MAX_QUEUE", { allowZero: true }),
+      timeoutMs: positiveInteger(env.CGW_SHIM_TIMEOUT_MS ?? String(DEFAULT_CGW_TIMEOUT_MS), "CGW_SHIM_TIMEOUT_MS"),
+      maxOutputBytes: positiveInteger(env.CGW_SHIM_MAX_OUTPUT_BYTES ?? "2097152", "CGW_SHIM_MAX_OUTPUT_BYTES"),
+      terminationGraceMs: positiveInteger(env.CGW_SHIM_TERMINATION_GRACE_MS ?? "1500", "CGW_SHIM_TERMINATION_GRACE_MS"),
+    },
+    cgw: {
+      baseUrl: cgwBaseUrl,
+      bearerFile: String(env.CGW_SHIM_CGW_BEARER_FILE || "").trim() || null,
+    },
+  };
+}
