--- /dev/null
+++ b/tools/cgw-codex-shim/run.js
@@ -0,0 +1,31 @@
+import { runCgwTurn } from "./cgwResponses.js";
+import { loadConfig } from "./config.js";
+import { startServer } from "./server.js";
+
+function formatAddress(address) {
+  const host = address.address.includes(":") ? `[${address.address}]` : address.address;
+  return `http://${host}:${address.port}`;
+}
+
+async function main() {
+  const config = loadConfig();
+  const runtime = await startServer({
+    config,
+    executeTurn: (request) => runCgwTurn({ config, ...request }),
+  });
+  let shutdownPromise;
+
+  const shutdown = () => {
+    if (!shutdownPromise) shutdownPromise = runtime.close();
+    return shutdownPromise;
+  };
+
+  process.once("SIGINT", () => { void shutdown(); });
+  process.once("SIGTERM", () => { void shutdown(); });
+  console.log(`CGW Chat shim listening at ${formatAddress(runtime.address)}`);
+}
+
+main().catch((error) => {
+  console.error(`cgw-codex-shim failed: ${error.message}`);
+  process.exitCode = 1;
+});
diff --git a/tools/cgw-codex-shim/server.js b/tools/cgw-codex-shim/server.js
new file mode 100644
index 00000000..55081d06
--- /dev/null
+++ b/tools/cgw-codex-shim/server.js
@@ -0,0 +1,207 @@
+import http from "node:http";
+import { randomUUID } from "node:crypto";
+import { errorResponse, jsonResponse, parseBearerToken, validateChatRequest } from "./http.js";
+
+class WorkQueue {
+  constructor(maxConcurrent, maxQueue) {
+    this.maxConcurrent = maxConcurrent;
+    this.maxQueue = maxQueue;
+    this.active = 0;
+    this.queue = [];
+  }
+
+  run(task, signal) {
+    return new Promise((resolve, reject) => {
+      const item = { task, resolve, reject, signal, onAbort: null };
+      if (this.active < this.maxConcurrent) {
+        this.start(item);
+      } else if (this.queue.length < this.maxQueue) {
+        this.queue.push(item);
+        if (signal) {
+          item.onAbort = () => {
+            const index = this.queue.indexOf(item);
+            if (index === -1) return;
+            this.queue.splice(index, 1);
+            signal.removeEventListener("abort", item.onAbort);
+            reject(signal.reason || new Error("request aborted while queued"));
+          };
+          signal.addEventListener("abort", item.onAbort, { once: true });
+          if (signal.aborted) item.onAbort();
+        }
+      } else {
+        const error = new Error("CGW execution queue is full");
+        error.statusCode = 429;
+        reject(error);
+      }
+    });
+  }
+
+  start(item) {
+    this.active += 1;
+    if (item.onAbort) {
+      item.signal?.removeEventListener("abort", item.onAbort);
+      item.onAbort = null;
+    }
+    Promise.resolve().then(item.task).then(item.resolve, item.reject).finally(() => {
+      this.active -= 1;
+      const next = this.queue.shift();
+      if (next) this.start(next);
+    });
+  }
+}
+
+function writeResponse(response, body, status = 200, headers = {}) {
+  const payload = Buffer.from(body);
+  response.writeHead(status, { "content-length": payload.length, ...headers });
+  response.end(payload);
+}
+
+function writeJson(response, body, status = 200, headers = {}) {
+  writeResponse(response, JSON.stringify(body), status, {
+    "content-type": "application/json; charset=utf-8",
+    ...headers,
+  });
+}
+
+function writeSse(response, { id, model, text }) {
+  response.writeHead(200, {
+    "cache-control": "no-cache, no-transform",
+    "connection": "keep-alive",
+    "content-type": "text/event-stream; charset=utf-8",
+    "x-accel-buffering": "no",
+  });
+  const created = Math.floor(Date.now() / 1000);
+  const write = (payload) => response.write(`data: ${JSON.stringify(payload)}\n\n`);
+  write({ id, object: "chat.completion.chunk", created, model, choices: [{ index: 0, delta: { role: "assistant", content: text }, finish_reason: null }] });
+  write({ id, object: "chat.completion.chunk", created, model, choices: [{ index: 0, delta: {}, finish_reason: "stop" }] });
+  response.write("data: [DONE]\n\n");
+  response.end();
+}
+
+async function readNodeBody(request, maxBytes) {
+  const chunks = [];
+  let size = 0;
+  for await (const chunk of request) {
+    size += chunk.length;
+    if (size > maxBytes) throw Object.assign(new Error("request body too large"), { statusCode: 413 });
+    chunks.push(chunk);
+  }
+  try {
+    return JSON.parse(Buffer.concat(chunks).toString("utf8") || "{}");
+  } catch {
+    throw Object.assign(new Error("request body must be valid JSON"), { statusCode: 400 });
+  }
+}
+
+export function createRequestHandler({ config, executeTurn }) {
+  const queue = new WorkQueue(config.limits.maxConcurrent, config.limits.maxQueue);
+  const activeControllers = new Set();
+
+  const requestHandler = async function requestHandler(request, response) {
+    const url = new URL(request.url || "/", `http://${request.headers.host || "127.0.0.1"}`);
+    if (url.pathname === "/health") {
+      writeJson(response, { ok: true, service: "cgw-codex-shim" });
+      return;
+    }
+
+    if (parseBearerToken(request.headers.authorization) !== config.apiKey) {
+      writeJson(response, { error: { message: "invalid bearer token", type: "authentication_error" } }, 401, { "www-authenticate": "Bearer" });
+      return;
+    }
+
+    if (request.method === "GET" && url.pathname === "/v1/models") {
+      writeJson(response, {
+        object: "list",
+        data: Object.keys(config.modelAliases).map((id) => ({ id, object: "model", owned_by: "cgw-codex-shim" })),
+      });
+      return;
+    }
+
+    if (request.method !== "POST" || url.pathname !== "/v1/chat/completions") {
+      writeJson(response, { error: { message: "not found", type: "not_found" } }, 404);
+      return;
+    }
+
+    let body;
+    try {
+      body = await readNodeBody(request, config.limits.maxBodyBytes);
+    } catch (error) {
+      writeJson(response, { error: { message: error.message, type: "invalid_request_error" } }, error.statusCode || 400);
+      return;
+    }
+
+    let requestInfo;
+    try {
+      requestInfo = validateChatRequest(body, config.modelAliases);
+    } catch (error) {
+      writeJson(response, { error: { message: error.message, type: "invalid_request_error" } }, 400);
+      return;
+    }
+
+    const abortController = new AbortController();
+    activeControllers.add(abortController);
+    const onAborted = () => abortController.abort(new Error("client disconnected"));
+    const onRequestClose = () => { if (!request.complete) onAborted(); };
+    const onResponseClose = () => { if (!response.writableEnded) onAborted(); };
+    request.once("aborted", onAborted);
+    request.once("close", onRequestClose);
+    response.once("close", onResponseClose);
+    const id = `chatcmpl-${randomUUID()}`;
+    try {
+      const result = await queue.run(() => executeTurn({
+        model: requestInfo.model,
+        prompt: requestInfo.prompt,
+        reasoningEffort: requestInfo.reasoningEffort,
+        signal: abortController.signal,
+      }), abortController.signal);
+      if (response.destroyed) return;
+      if (body.stream === true) {
+        writeSse(response, { id, model: body.model, text: result.text });
+      } else {
+        writeJson(response, {
+          id,
+          object: "chat.completion",
+          created: Math.floor(Date.now() / 1000),
+          model: body.model,
+          choices: [{ index: 0, message: { role: "assistant", content: result.text }, finish_reason: "stop" }],
+        });
+      }
+    } catch (error) {
+      if (response.destroyed) return;
+      const headers = error.dispatchStarted ? { "x-9router-no-replay": "1" } : {};
+      writeJson(response, { error: { message: error.message || "native execution failed", type: "upstream_error", code: error.code || "native_execution_failed" } }, error.statusCode || 502, headers);
+    } finally {
+      activeControllers.delete(abortController);
+      request.off("aborted", onAborted);
+      request.off("close", onRequestClose);
+      response.off("close", onResponseClose);
+    }
+  };
+
+  requestHandler.shutdown = () => {
+    for (const controller of activeControllers) {
+      controller.abort(new Error("server shutting down"));
+    }
+  };
+
+  return requestHandler;
+}
+
+export async function startServer({ config, executeTurn }) {
+  const requestHandler = createRequestHandler({ config, executeTurn });
+  const server = http.createServer((request, response) => {
+    void requestHandler(request, response);
+  });
+  await new Promise((resolve, reject) => {
+    server.once("error", reject);
+    server.listen(config.port, config.host, resolve);
+  });
+  return {
+    server,
+    address: server.address(),
+    close: () => new Promise((resolve, reject) => {
+      requestHandler.shutdown();
+      server.close((error) => error ? reject(error) : resolve());
+    }),
+  };
+}
diff --git a/tools/cgw-codex-shim/smoke.js b/tools/cgw-codex-shim/smoke.js
new file mode 100644
index 00000000..727af433
--- /dev/null
+++ b/tools/cgw-codex-shim/smoke.js
@@ -0,0 +1,66 @@
+import { loadConfig } from "./config.js";
+import { runCgwTurn } from "./cgwResponses.js";
+import { startServer } from "./server.js";
+
+function printHelp() {
+  console.log(`Usage: node tools/cgw-codex-shim/smoke.js [options]
+
+Options:
+  --model <alias>   Configured shim alias (defaults to the first alias)
+  --prompt <text>   Single prompt (defaults to CGW_SHIM_SMOKE_PROMPT)
+  --help            Show this help
+
+Required environment is documented in tools/cgw-codex-shim/README.md.
+`);
+}
+
+function parseArgs(argv) {
+  const options = {};
+  for (let index = 0; index < argv.length; index += 1) {
+    const arg = argv[index];
+    if (arg === "--help") options.help = true;
+    else if (arg === "--model") options.model = argv[++index];
+    else if (arg === "--prompt") options.prompt = argv[++index];
+    else throw new Error(`unknown option: ${arg}`);
+  }
+  return options;
+}
+
+async function main() {
+  const options = parseArgs(process.argv.slice(2));
+  if (options.help) {
+    printHelp();
+    return;
+  }
+
+  const config = loadConfig();
+  const model = options.model || Object.keys(config.modelAliases)[0];
+  if (!config.modelAliases[model]) throw new Error(`model alias is not configured: ${model}`);
+  const prompt = options.prompt || process.env.CGW_SHIM_SMOKE_PROMPT || "Reply with CGW_SHIM_CHAT_OK only.";
+  const runtime = await startServer({
+    config,
+    executeTurn: (request) => runCgwTurn({ config, ...request }),
+  });
+
+  try {
+    const baseUrl = `http://${runtime.address.address}:${runtime.address.port}`;
+    const response = await fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: {
+        authorization: `Bearer ${config.apiKey}`,
+        "content-type": "application/json",
+      },
+      body: JSON.stringify({ model, messages: [{ role: "user", content: prompt }] }),
+    });
+    const body = await response.json();
+    if (!response.ok) throw new Error(body?.error?.message || `shim returned HTTP ${response.status}`);
+    console.log(JSON.stringify({ ok: true, model, text: body.choices?.[0]?.message?.content || "" }));
+  } finally {
+    await runtime.close();
+  }
+}
+
+main().catch((error) => {
+  console.error(`smoke failed: ${error.message}`);
+  process.exitCode = 1;
+});
diff --git a/tools/cgw-codex-shim/test/cgw-responses.test.js b/tools/cgw-codex-shim/test/cgw-responses.test.js
new file mode 100644
index 00000000..af7c1be1
--- /dev/null
+++ b/tools/cgw-codex-shim/test/cgw-responses.test.js
@@ -0,0 +1,122 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { buildCgwResponseRequest, extractResponseText, mapReasoningEffort, readBearerToken, resolveBearer, runCgwTurn } from "../cgwResponses.js";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+
+const config = {
+  cgw: { baseUrl: "http://127.0.0.1:17841/v1", bearerFile: null },
+  limits: { timeoutMs: 1000, maxOutputBytes: 256 },
+};
+
+test("builds a direct CGW Responses request with the requested model and effort", () => {
+  const request = buildCgwResponseRequest({
+    ...config.cgw,
+    bearer: "cgw-token",
+    model: "chatgpt-web/gpt-6-sol",
+    prompt: "Reply with CGW_OK only.",
+    reasoningEffort: "high",
+  });
+  assert.equal(request.url.toString(), "http://127.0.0.1:17841/v1/responses");
+  assert.equal(request.init.headers.authorization, "Bearer cgw-token");
+  const body = JSON.parse(request.init.body);
+  assert.equal(body.model, "chatgpt-web/gpt-6-sol");
+  assert.equal(body.input[0].role, "user");
+  assert.deepEqual(body.input[0].content, [{ type: "input_text", text: "Reply with CGW_OK only." }]);
+  assert.match(body.input[0].id, /^msg_[A-Za-z0-9-]+$/);
+  assert.match(body.input[0].internal_chat_message_metadata_passthrough.turn_id, /^turn_[A-Za-z0-9-]+$/);
+  assert.match(body.client_metadata["x-codex-turn-metadata"], /"request_kind":"turn"/);
+  assert.equal(body.store, false);
+  assert.equal(body.stream, false);
+  assert.deepEqual(body.reasoning, { effort: "high" });
+});
+
+test("maps public low effort to CGW instant effort", () => {
+  assert.equal(mapReasoningEffort("low"), "instant");
+  const request = buildCgwResponseRequest({
+    ...config.cgw,
+    bearer: "cgw-token",
+    model: "chatgpt-web/gpt-6-sol",
+    prompt: "Reply with CGW_OK only.",
+    reasoningEffort: "low",
+  });
+  assert.deepEqual(JSON.parse(request.init.body).reasoning, { effort: "instant" });
+});
+
+test("extracts assistant text from Responses output", () => {
+  assert.equal(extractResponseText({ output_text: "direct" }), "direct");
+  assert.equal(extractResponseText({ output: [{ type: "message", content: [{ type: "output_text", text: "nested" }] }] }), "nested");
+  assert.equal(extractResponseText({ output: [] }), null);
+  assert.equal(extractResponseText({ output: [
+    { type: "message", content: [{ type: "output_text", text: "commentary" }] },
+    { type: "message", content: [{ type: "output_text", text: "final" }] },
+  ] }), "final");
+});
+
+test("reads a bearer from a local env file without exposing it in the request contract", async () => {
+  const directory = await mkdtemp(path.join(os.tmpdir(), "cgw-bearer-"));
+  const filePath = path.join(directory, "cgw.env");
+  try {
+    await writeFile(filePath, "CGW_SHIM_CGW_BEARER=local-token\n", "utf8");
+    assert.equal(readBearerToken(filePath), "local-token");
+    assert.equal(resolveBearer({ cgw: { bearerFile: filePath } }, {}), "local-token");
+  } finally {
+    await rm(directory, { recursive: true, force: true });
+  }
+});
+
+test("runs real CGW inference through Responses without invoking native Codex", async () => {
+  let call;
+  const result = await runCgwTurn({
+    config,
+    model: "chatgpt-web/gpt-5.6-sol",
+    prompt: "Reply with CGW_OK only.",
+    signal: undefined,
+    bearer: "test-bearer",
+    fetchImpl: async (url, init) => {
+      call = { url: String(url), init };
+      return new Response(JSON.stringify({ id: "resp_1", model: "chatgpt-web/gpt-5.6-sol", output_text: "CGW_OK" }), { status: 200 });
+    },
+  });
+  assert.equal(result.text, "CGW_OK");
+  assert.equal(call.url, "http://127.0.0.1:17841/v1/responses");
+  assert.equal(call.init.headers.authorization, "Bearer test-bearer");
+  const body = JSON.parse(call.init.body);
+  assert.equal(body.model, "chatgpt-web/gpt-5.6-sol");
+  assert.equal(body.input[0].internal_chat_message_metadata_passthrough.turn_id.length > 0, true);
+  assert.match(body.client_metadata["x-codex-turn-metadata"], /"turn_id"/);
+});
+
+test("rejects a CGW response whose model does not match the requested browser model", async () => {
+  await assert.rejects(() => runCgwTurn({
+    config,
+    model: "chatgpt-web/gpt-5.6-sol",
+    prompt: "Reply with CGW_OK only.",
+    bearer: "test-bearer",
+    fetchImpl: async () => new Response(JSON.stringify({ model: "chatgpt-web/gpt-6-sol", output_text: "wrong" }), { status: 200 }),
+  }), /model mismatch/);
+});
+
+test("rejects a successful CGW response without a model identity", async () => {
+  await assert.rejects(() => runCgwTurn({
+    config,
+    model: "chatgpt-web/gpt-5.6-sol",
+    prompt: "Reply with CGW_OK only.",
+    bearer: "test-bearer",
+    fetchImpl: async () => new Response(JSON.stringify({ output_text: "CGW_OK" }), { status: 200 }),
+  }), /model mismatch/);
+});
+
+test("bounds the CGW response body before parsing it", async () => {
+  await assert.rejects(() => runCgwTurn({
+    config,
+    model: "chatgpt-web/gpt-5.6-sol",
+    prompt: "Reply with CGW_OK only.",
+    bearer: "test-bearer",
+    fetchImpl: async () => new Response(JSON.stringify({
+      model: "chatgpt-web/gpt-5.6-sol",
+      output_text: "x".repeat(500),
+    }), { status: 200 }),
+  }), /response body too large/);
+});
diff --git a/tools/cgw-codex-shim/test/config.test.js b/tools/cgw-codex-shim/test/config.test.js
new file mode 100644
index 00000000..a4525608
--- /dev/null
+++ b/tools/cgw-codex-shim/test/config.test.js
@@ -0,0 +1,88 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtemp, writeFile, rm } from "node:fs/promises";
+import os from "node:os";
+import path from "node:path";
+import { loadConfig, parseModelAliases } from "../config.js";
+import { loadEnvFileIntoProcess } from "../env.js";
+
+const baseEnv = {
+  CGW_SHIM_API_KEY: "test-key",
+  CGW_SHIM_MODEL_ALIASES_JSON: JSON.stringify({ "gpt-test": "chatgpt-web/gpt-test" }),
+  CGW_SHIM_CGW_BASE_URL: "http://127.0.0.1:17841/v1",
+  CGW_SHIM_CGW_BEARER_FILE: "C:/cgw-bearer.env",
+};
+
+test("parses deterministic model aliases", () => {
+  assert.deepEqual(parseModelAliases('{"gpt-a":"chatgpt-web/gpt-a","gpt-b":"chatgpt-web/gpt-b"}'), {
+    "gpt-a": "chatgpt-web/gpt-a",
+    "gpt-b": "chatgpt-web/gpt-b",
+  });
+});
+
+test("loads dotenv values into the process environment", async () => {
+  const directory = await mkdtemp(path.join(os.tmpdir(), "cgw-codex-shim-"));
+  const envPath = path.join(directory, ".env");
+  const name = "CGW_SHIM_TEST_LOADED_VALUE";
+  const previous = process.env[name];
+
+  try {
+    await writeFile(envPath, `${name}=loaded-from-dotenv\n`, "utf8");
+    delete process.env[name];
+    assert.equal(loadEnvFileIntoProcess(envPath), true);
+    assert.equal(process.env[name], "loaded-from-dotenv");
+  } finally {
+    if (previous === undefined) delete process.env[name];
+    else process.env[name] = previous;
+    await rm(directory, { recursive: true, force: true });
+  }
+});
+test("rejects malformed or empty model aliases", () => {
+  assert.throws(() => parseModelAliases("[]"), /object/);
+  assert.throws(() => parseModelAliases('{"":"native"}'), /alias/);
+  assert.throws(() => parseModelAliases('{"public":""}'), /target model/);
+  assert.throws(() => parseModelAliases('{"public":"gpt-5.6-sol"}'), /chatgpt-web/);
+});
+
+test("loads fail-closed loopback configuration", () => {
+  const config = loadConfig(baseEnv);
+  assert.equal(config.host, "127.0.0.1");
+  assert.equal(config.apiKey, "test-key");
+  assert.deepEqual(config.modelAliases, { "gpt-test": "chatgpt-web/gpt-test" });
+  assert.equal(config.cgw.baseUrl, "http://127.0.0.1:17841/v1");
+  assert.equal(config.cgw.bearerFile, "C:/cgw-bearer.env");
+});
+
+test("defaults to a native-context-safe request body budget", () => {
+  const config = loadConfig(baseEnv);
+
+  assert.equal(config.limits.maxBodyBytes, 1024 * 1024);
+});
+
+test("defaults to a bounded CGW latency budget", () => {
+  const config = loadConfig(baseEnv);
+
+  assert.equal(config.limits.timeoutMs, 600000);
+});
+
+test("rejects non-loopback binds and missing dedicated keys", () => {
+  assert.throws(() => loadConfig({ ...baseEnv, CGW_SHIM_HOST: "0.0.0.0" }), /loopback/);
+  assert.throws(() => loadConfig({ ...baseEnv, CGW_SHIM_CGW_BASE_URL: "https://example.test/v1" }), /http loopback/);
+  const { CGW_SHIM_API_KEY: _, ...withoutKey } = baseEnv;
+  assert.throws(() => loadConfig(withoutKey), /CGW_SHIM_API_KEY/);
+});
+
+test("parses bounded numeric settings", () => {
+  const config = loadConfig({
+    ...baseEnv,
+    CGW_SHIM_MAX_BODY_BYTES: "1024",
+    CGW_SHIM_MAX_CONCURRENT: "2",
+    CGW_SHIM_MAX_QUEUE: "3",
+    CGW_SHIM_TIMEOUT_MS: "5000",
+  });
+  assert.equal(config.limits.maxBodyBytes, 1024);
+  assert.equal(config.limits.maxConcurrent, 2);
+  assert.equal(config.limits.maxQueue, 3);
+  assert.equal(config.limits.timeoutMs, 5000);
+  assert.throws(() => loadConfig({ ...baseEnv, CGW_SHIM_TIMEOUT_MS: "0" }), /TIMEOUT/i);
+});
diff --git a/tools/cgw-codex-shim/test/http-boundary.test.js b/tools/cgw-codex-shim/test/http-boundary.test.js
new file mode 100644
index 00000000..8401c95c
--- /dev/null
+++ b/tools/cgw-codex-shim/test/http-boundary.test.js
@@ -0,0 +1,89 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { validateChatRequest, parseBearerToken, readJsonBody } from "../http.js";
+
+test("accepts one plain user message", () => {
+  const result = validateChatRequest({
+    model: "gpt-test",
+    messages: [{ role: "user", content: "hello" }],
+  }, { "gpt-test": "chatgpt-web/gpt-test" });
+  assert.deepEqual(result, { model: "chatgpt-web/gpt-test", prompt: "hello" });
+});
+
+test("flattens interactive multi-message text into one CGW prompt", () => {
+  const result = validateChatRequest({
+    model: "gpt-test",
+    messages: [
+      { role: "system", content: "Follow the review contract." },
+      { role: "user", content: "Reply with CGW_LIVE_PROBE_OK." },
+    ],
+  }, { "gpt-test": "chatgpt-web/gpt-test" });
+  assert.equal(result.prompt, "[system]\nFollow the review contract.\n\n[user]\nReply with CGW_LIVE_PROBE_OK.");
+});
+
+test("flattens text-only content blocks from interactive Codex messages", () => {
+  const result = validateChatRequest({
+    model: "gpt-test",
+    messages: [{
+      role: "user",
+      content: [
+        { type: "input_text", text: "Reply with " },
+        { type: "text", text: "CGW_LIVE_PROBE_OK." },
+      ],
+    }],
+  }, { "gpt-test": "chatgpt-web/gpt-test" });
+  assert.equal(result.prompt, "Reply with CGW_LIVE_PROBE_OK.");
+});
+
+test("accepts only low, medium, and high reasoning effort values", () => {
+  for (const effort of ["low", "medium", "high"]) {
+    const result = validateChatRequest({
+      model: "gpt-test",
+      reasoning_effort: effort,
+      messages: [{ role: "user", content: "hello" }],
+    }, { "gpt-test": "chatgpt-web/gpt-test" });
+    assert.equal(result.reasoningEffort, effort);
+  }
+  assert.throws(() => validateChatRequest({
+    model: "gpt-test",
+    reasoning_effort: "normal",
+    messages: [{ role: "user", content: "hello" }],
+  }, { "gpt-test": "chatgpt-web/gpt-test" }), /reasoning_effort/);
+});
+
+test("ignores client tool metadata for text-only CGW reviews", () => {
+  const result = validateChatRequest({
+    model: "gpt-test",
+    tools: [{ type: "function", function: { name: "read_github" } }],
+    tool_choice: "auto",
+    messages: [{ role: "user", content: "Review the GitHub URL." }],
+  }, { "gpt-test": "chatgpt-web/gpt-test" });
+  assert.deepEqual(result, {
+    model: "chatgpt-web/gpt-test",
+    prompt: "Review the GitHub URL.",
+    toolsIgnored: true,
+  });
+});
+
+test("rejects unsupported roles and multimodal content", () => {
+  assert.throws(() => validateChatRequest({ model: "gpt-test", messages: [{ role: "unknown", content: "x" }] }, { "gpt-test": "chatgpt-web/gpt-test" }), /text message roles/);
+  assert.throws(() => validateChatRequest({ model: "gpt-test", messages: [{ role: "user", content: [{ type: "image_url" }] }] }, { "gpt-test": "chatgpt-web/gpt-test" }), /text/);
+});
+
+test("parses bearer authentication without accepting malformed values", () => {
+  assert.equal(parseBearerToken("Bearer secret"), "secret");
+  assert.equal(parseBearerToken("Basic secret"), null);
+  assert.equal(parseBearerToken("Bearer"), null);
+});
+
+test("reads bounded JSON bodies", async () => {
+  const request = new Request("http://127.0.0.1", {
+    method: "POST",
+    body: JSON.stringify({ hello: "world" }),
+  });
+  assert.deepEqual(await readJsonBody(request, 1024), { hello: "world" });
+  await assert.rejects(() => readJsonBody(new Request("http://127.0.0.1", {
+    method: "POST",
+    body: "x".repeat(20),
+  }), 5), /body too large/);
+});
diff --git a/tools/cgw-codex-shim/test/server.test.js b/tools/cgw-codex-shim/test/server.test.js
new file mode 100644
index 00000000..668d5fad
--- /dev/null
+++ b/tools/cgw-codex-shim/test/server.test.js
@@ -0,0 +1,250 @@
+import http from "node:http";
+import test from "node:test";
+import assert from "node:assert/strict";
+import { startServer } from "../server.js";
+
+function testConfig(overrides = {}) {
+  return {
+    host: "127.0.0.1",
+    port: 0,
+    apiKey: "test-key",
+    modelAliases: { "gpt-test": "gpt-test" },
+    limits: { maxBodyBytes: 64 * 1024, maxConcurrent: 1, maxQueue: 2, timeoutMs: 1000 },
+    cgw: { baseUrl: "http://127.0.0.1:17841/v1", bearerFile: null },
+    ...overrides,
+  };
+}
+
+async function withServer(executeTurn, callback, config = testConfig()) {
+  const runtime = await startServer({ config, executeTurn });
+  try {
+    return await callback(`http://${runtime.address.address}:${runtime.address.port}`);
+  } finally {
+    await runtime.close();
+  }
+}
+
+function headers() {
+  return { authorization: "Bearer test-key", "content-type": "application/json" };
+}
+
+test("lists only configured aliases and requires auth", async () => {
+  await withServer(async () => ({ text: "unused", dispatchStarted: true }), async (baseUrl) => {
+    const unauthorized = await fetch(`${baseUrl}/v1/models`);
+    assert.equal(unauthorized.status, 401);
+    const response = await fetch(`${baseUrl}/v1/models`, { headers: { authorization: "Bearer test-key" } });
+    assert.equal(response.status, 200);
+    assert.deepEqual((await response.json()).data.map((item) => item.id), ["gpt-test"]);
+  });
+});
+
+test("returns a non-stream chat completion", async () => {
+  await withServer(async ({ model, prompt }) => {
+    assert.equal(model, "gpt-test");
+    assert.equal(prompt, "hello");
+    return { text: "hello back", dispatchStarted: true };
+  }, async (baseUrl) => {
+    const response = await fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: headers(),
+      body: JSON.stringify({
+        model: "gpt-test",
+        tools: [{ type: "function", function: { name: "read_github" } }],
+        tool_choice: "auto",
+        messages: [{ role: "user", content: "hello" }],
+      }),
+    });
+    assert.equal(response.status, 200);
+    const body = await response.json();
+    assert.equal(body.model, "gpt-test");
+    assert.equal(body.choices[0].message.content, "hello back");
+  });
+});
+
+test("accepts native sub-agent context above the legacy 64 KiB budget", async () => {
+  const prompt = "x".repeat(70 * 1024);
+  await withServer(async ({ prompt: receivedPrompt }) => {
+    assert.equal(receivedPrompt, prompt);
+    return { text: "ok", dispatchStarted: true };
+  }, async (baseUrl) => {
+    const response = await fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: headers(),
+      body: JSON.stringify({ model: "gpt-test", messages: [{ role: "user", content: prompt }] }),
+    });
+
+    assert.equal(response.status, 200);
+  }, testConfig({ limits: { maxBodyBytes: 1024 * 1024, maxConcurrent: 1, maxQueue: 1, timeoutMs: 1000 } }));
+});
+
+test("passes reasoning effort through to CGW execution", async () => {
+  await withServer(async ({ reasoningEffort }) => {
+    assert.equal(reasoningEffort, "high");
+    return { text: "reasoned", dispatchStarted: true };
+  }, async (baseUrl) => {
+    const response = await fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: headers(),
+      body: JSON.stringify({ model: "gpt-test", reasoning_effort: "high", messages: [{ role: "user", content: "hello" }] }),
+    });
+    assert.equal(response.status, 200);
+  });
+});
+
+test("returns valid buffered SSE", async () => {
+  await withServer(async () => ({ text: "streamed", dispatchStarted: true }), async (baseUrl) => {
+    const response = await fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: headers(),
+      body: JSON.stringify({ model: "gpt-test", stream: true, messages: [{ role: "user", content: "hello" }] }),
+    });
+    assert.equal(response.status, 200);
+    assert.match(response.headers.get("content-type"), /text\/event-stream/);
+    const text = await response.text();
+    assert.match(text, /data: \{.*"delta".*streamed.*\}/);
+    assert.match(text, /data: \[DONE\]/);
+  });
+});
+
+test("accepts text context but rejects multimodal input before execution", async () => {
+  let calls = 0;
+  let prompt;
+  await withServer(async ({ prompt: receivedPrompt }) => {
+    calls += 1;
+    prompt = receivedPrompt;
+    return { text: "ok", dispatchStarted: true };
+  }, async (baseUrl) => {
+    const contextResponse = await fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: headers(),
+      body: JSON.stringify({ model: "gpt-test", messages: [
+        { role: "system", content: "Follow the contract." },
+        { role: "user", content: "Reply with ok." },
+      ] }),
+    });
+    assert.equal(contextResponse.status, 200);
+    assert.equal(prompt, "[system]\nFollow the contract.\n\n[user]\nReply with ok.");
+
+    const multimodalResponse = await fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: headers(),
+      body: JSON.stringify({ model: "gpt-test", messages: [{ role: "user", content: [{ type: "image_url", image_url: "https://example.test/image.png" }] }] }),
+    });
+    assert.equal(multimodalResponse.status, 400);
+    assert.equal(calls, 1);
+  });
+});
+
+test("marks CGW failures as non-replayable after dispatch", async () => {
+  await withServer(async () => {
+    const error = new Error("CGW failed");
+    error.dispatchStarted = true;
+    throw error;
+  }, async (baseUrl) => {
+    const response = await fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: headers(),
+      body: JSON.stringify({ model: "gpt-test", messages: [{ role: "user", content: "hello" }] }),
+    });
+    assert.equal(response.status, 502);
+    assert.equal(response.headers.get("x-9router-no-replay"), "1");
+  });
+});
+
+test("shares concurrency and queue limits across requests", async () => {
+  let release;
+  const gate = new Promise((resolve) => { release = resolve; });
+  let calls = 0;
+  await withServer(async () => {
+    calls += 1;
+    await gate;
+    return { text: "ok", dispatchStarted: true };
+  }, async (baseUrl) => {
+    const request = () => fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: headers(),
+      body: JSON.stringify({ model: "gpt-test", messages: [{ role: "user", content: "hello" }] }),
+    });
+
+    const first = request();
+    await new Promise((resolve) => setTimeout(resolve, 25));
+    const second = request();
+    const third = request();
+    await new Promise((resolve) => setTimeout(resolve, 25));
+    assert.equal(calls, 1);
+
+    release();
+    const responses = await Promise.all([first, second]);
+    assert.deepEqual(responses.map((response) => response.status), [200, 200]);
+    const rejected = await third;
+    assert.equal(rejected.status, 429);
+    const payload = await rejected.json();
+    assert.equal(payload.error.message, "CGW execution queue is full");
+    assert.doesNotMatch(payload.error.message, /native execution/i);
+  }, testConfig({ limits: { maxBodyBytes: 64 * 1024, maxConcurrent: 1, maxQueue: 1, timeoutMs: 1000 } }));
+});
+
+test("removes disconnected requests from the queue before dispatch", async () => {
+  let release;
+  const gate = new Promise((resolve) => { release = resolve; });
+  let calls = 0;
+  await withServer(async () => {
+    calls += 1;
+    if (calls === 1) await gate;
+    return { text: "ok", dispatchStarted: true };
+  }, async (baseUrl) => {
+    const request = (signal) => fetch(`${baseUrl}/v1/chat/completions`, {
+      method: "POST",
+      headers: headers(),
+      body: JSON.stringify({ model: "gpt-test", messages: [{ role: "user", content: "hello" }] }),
+      signal,
+    });
+
+    const first = request();
+    await new Promise((resolve) => setTimeout(resolve, 25));
+
+    const abandoned = http.request(`${baseUrl}/v1/chat/completions`, {
