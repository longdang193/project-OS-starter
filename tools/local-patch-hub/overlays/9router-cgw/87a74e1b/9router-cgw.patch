diff --git a/tests/unit/account-fallback-cgw-queue.test.js b/tests/unit/account-fallback-cgw-queue.test.js
new file mode 100644
index 00000000..e2acc200
--- /dev/null
+++ b/tests/unit/account-fallback-cgw-queue.test.js
@@ -0,0 +1,51 @@
+import { describe, it, expect } from "vitest";
+import { checkFallbackError } from "../../open-sse/services/accountFallback.js";
+import { handleComboChat } from "../../open-sse/services/combo.js";
+
+describe("CGW queue saturation", () => {
+  it("does not trigger account fallback or quota backoff", () => {
+    expect(checkFallbackError(429, "CGW execution queue is full", 2)).toEqual({
+      shouldFallback: false,
+      cooldownMs: 0,
+      newBackoffLevel: 2,
+    });
+  });
+
+  it("stops combo fallback on the local queue boundary", async () => {
+    let calls = 0;
+    const result = await handleComboChat({
+      body: { model: "combo-web-high" },
+      models: ["cgw/gpt-6.1-sol", "cgw/gpt-5.6-sol"],
+      handleSingleModel: async () => {
+        calls += 1;
+        return new Response(JSON.stringify({ error: { message: "CGW execution queue is full" } }), {
+          status: 429,
+          headers: { "content-type": "application/json" },
+        });
+      },
+      log: { info() {}, warn() {} },
+    });
+
+    expect(result.status).toBe(429);
+    expect(calls).toBe(1);
+  });
+
+  it("stops combo fallback after CGW dispatch", async () => {
+    let calls = 0;
+    const result = await handleComboChat({
+      body: { model: "combo-web-high" },
+      models: ["cgw/gpt-6.1-sol", "cgw/gpt-5.6-sol"],
+      handleSingleModel: async () => {
+        calls += 1;
+        return new Response(JSON.stringify({ error: { message: "CGW upstream failed" } }), {
+          status: 502,
+          headers: { "x-9router-no-replay": "1" },
+        });
+      },
+      log: { info() {}, warn() {} },
+    });
+
+    expect(result.status).toBe(502);
+    expect(calls).toBe(1);
+  });
+});
diff --git a/tools/cgw-codex-shim/README.md b/tools/cgw-codex-shim/README.md
new file mode 100644
index 00000000..622608c9
--- /dev/null
+++ b/tools/cgw-codex-shim/README.md
@@ -0,0 +1,105 @@
+# CGW Chat Shim
+
+This directory contains a loopback-only OpenAI-compatible adapter for the
+installed CGW runtime. It translates plain-text Chat Completions requests into
+one direct CGW Responses request.
+
+## Scope
+
+- `GET /v1/models` exposes only aliases configured in
+  `CGW_SHIM_MODEL_ALIASES_JSON`.
+- `POST /v1/chat/completions` accepts one or more non-empty plain-text messages;
+  a single `user` message is passed unchanged and interactive multi-message
+  context is flattened into one labeled CGW prompt.
+- `reasoning_effort` accepts `low`, `medium`, or `high`. The public `low` value
+  is translated to CGW's `instant` Responses effort; `medium` and `high` are
+  passed through unchanged.
+- `stream: true` returns buffered compatibility SSE; it is not live token
+  streaming.
+- Client tool declarations are ignored because CGW Chat is text-only; tools are never
+  executed. Text-only system, developer, user, assistant, tool, and function
+  messages are flattened before dispatch; images, audio, and response-format
+  options are rejected.
+- The service binds only to loopback and requires a dedicated local bearer key.
+- CGW inference is performed directly against its local `/v1/responses` bridge;
+  it never launches `codex exec` and never routes CGW aliases through 9Router's
+  Codex provider.
+- A missing CGW bearer fails closed before dispatch. Upstream failures after
+  dispatch include `x-9router-no-replay: 1` as an advisory diagnostic for the
+  parent 9Router replay policy.
+- Requests that disconnect while waiting in the bounded queue are removed before
+  CGW dispatch, so abandoned retries do not consume CGW execution capacity.
+
+The default queue admits one active CGW request and keeps up to eight additional
+requests waiting. The tenth simultaneous request receives HTTP `429`. This is
+the shim's CGW chat queue, not a native `codex exec` queue. Herdr's normal
+`combo-web-*` single-flight admission should keep this queue nearly empty;
+direct clients, bypassed Herdr launches, or duplicate retries can still fill it.
+If native `codex exec` output appears, the request used a different or stale
+adapter path and did not come through this direct CGW transport.
+
+## Configuration
+
+The shim automatically loads `.env` from the repository root when any shim
+entrypoint starts. Existing process environment variables remain authoritative.
+Keep the real `.env` uncommitted.
+
+Start the long-running shim with:
+
+```powershell
+node tools/cgw-codex-shim/run.js
+```
+
+The equivalent variables are:
+
+```dotenv
+CGW_SHIM_HOST=127.0.0.1
+CGW_SHIM_PORT=20129
+CGW_SHIM_API_KEY=use-a-dedicated-local-key
+CGW_SHIM_MODEL_ALIASES_JSON={"gpt-6.1-sol":"chatgpt-web/gpt-6-sol","gpt-5.6-sol":"chatgpt-web/gpt-5.6-sol"}
+CGW_SHIM_CGW_BASE_URL=http://127.0.0.1:17841/v1
+# Use one of these local-only bearer sources. Never commit the value.
+CGW_SHIM_CGW_BEARER_FILE=C:\\Users\\me\\.codex\\cgw-bearer.env
+# CGW_SHIM_CGW_BEARER=use-a-current-native-bearer
+```
+
+The bearer file may contain a raw token or one of these assignments:
+
+```dotenv
+CGW_SHIM_CGW_BEARER=...
+OPENAI_ACCESS_TOKEN=...
+ACCESS_TOKEN=...
+```
+
+The bearer must be accepted by the authenticated CGW Responses bridge. An
+OpenAI API key beginning with `sk-` is not a substitute for this bearer. The
+shim reads the bearer at request time and never logs or returns it.
+
+The default limits are bounded and can be overridden with
+`CGW_SHIM_MAX_BODY_BYTES`, `CGW_SHIM_MAX_CONCURRENT`, `CGW_SHIM_MAX_QUEUE`,
+`CGW_SHIM_TIMEOUT_MS`, and `CGW_SHIM_TERMINATION_GRACE_MS`.
+The default request-body budget is 1 MiB: it accommodates native sub-agent
+context envelopes while retaining a finite protection against oversized
+requests. Set `CGW_SHIM_MAX_BODY_BYTES` explicitly when a smaller deployment
+budget is required.
+The default CGW request budget is 600 seconds to accommodate slower
+authenticated browser-backed turns. Set `CGW_SHIM_TIMEOUT_MS` explicitly when
+the deployment has a tighter provider deadline. A timeout after dispatch is
+reported as non-replayable; do not retry until the original attempt is
+retired and its outcome is reconciled.
+
+## Checks
+
+```powershell
+node --test tools/cgw-codex-shim/test/*.test.js
+node tools/cgw-codex-shim/smoke.js --help
+```
+
+For a live inference smoke, configure a valid bearer and run:
+
+```powershell
+node tools/cgw-codex-shim/smoke.js --model gpt-6.1-sol --prompt "Reply with CGW_SHIM_CHAT_OK only."
+```
+
+The command prints only the selected alias and returned text. It does not print
+the bearer key or request headers.
diff --git a/tools/cgw-codex-shim/cgwResponses.js b/tools/cgw-codex-shim/cgwResponses.js
new file mode 100644
index 00000000..d3a0514f
--- /dev/null
+++ b/tools/cgw-codex-shim/cgwResponses.js
@@ -0,0 +1,174 @@
+import { readFileSync } from "node:fs";
+import { randomUUID } from "node:crypto";
+
+function errorWithState(message, dispatchStarted, code, statusCode) {
+  const error = new Error(message);
+  error.dispatchStarted = dispatchStarted;
+  error.code = code;
+  if (statusCode) error.statusCode = statusCode;
+  return error;
+}
+
+function normalizeBearer(value) {
+  const token = String(value || "").trim();
+  if (!token) return null;
+  return token.replace(/^Bearer\s+/i, "").trim() || null;
+}
+
+async function readResponseTextBounded(response, maxBytes) {
+  const limit = Number(maxBytes);
+  if (!Number.isInteger(limit) || limit < 1 || !response.body?.getReader) {
+    const rawText = await response.text();
+    if (Number.isInteger(limit) && limit > 0 && Buffer.byteLength(rawText, "utf8") > limit) {
+      throw errorWithState("CGW response body too large", true, "cgw_response_too_large", 502);
+    }
+    return rawText;
+  }
+
+  const reader = response.body.getReader();
+  const chunks = [];
+  let size = 0;
+  try {
+    while (true) {
+      const { done, value } = await reader.read();
+      if (done) break;
+      size += value.byteLength;
+      if (size > limit) {
+        await reader.cancel().catch(() => {});
+        throw errorWithState("CGW response body too large", true, "cgw_response_too_large", 502);
+      }
+      chunks.push(Buffer.from(value));
+    }
+  } finally {
+    reader.releaseLock();
+  }
+  return Buffer.concat(chunks).toString("utf8");
+}
+
+export function readBearerToken(filePath) {
+  const lines = readFileSync(filePath, "utf8").split(/\r?\n/);
+  for (const line of lines) {
+    const match = line.match(/^\s*(?:CGW_SHIM_CGW_BEARER|OPENAI_ACCESS_TOKEN|ACCESS_TOKEN)\s*=\s*(.*?)\s*$/);
+    if (match) return normalizeBearer(match[1]);
+  }
+  return normalizeBearer(readFileSync(filePath, "utf8"));
+}
+
+export function resolveBearer(config, sourceEnv = process.env) {
+  const direct = normalizeBearer(sourceEnv.CGW_SHIM_CGW_BEARER);
+  if (direct) return direct;
+  if (config.cgw.bearerFile) {
+    const fileValue = readBearerToken(config.cgw.bearerFile);
+    if (fileValue) return fileValue;
+  }
+  throw errorWithState(
+    "CGW bearer is not configured; set CGW_SHIM_CGW_BEARER or CGW_SHIM_CGW_BEARER_FILE",
+    false,
+    "cgw_bearer_missing",
+    503,
+  );
+}
+
+export function buildCgwResponseRequest({ baseUrl, bearer, model, prompt, reasoningEffort, signal }) {
+  const url = new URL("responses", `${String(baseUrl).replace(/\/$/, "")}/`);
+  const threadId = `thread_${randomUUID()}`;
+  const turnId = `turn_${randomUUID()}`;
+  const itemId = `msg_${randomUUID()}`;
+  const body = {
+    model,
+    input: [{
+      type: "message",
+      id: itemId,
+      role: "user",
+      content: [{ type: "input_text", text: prompt }],
+      internal_chat_message_metadata_passthrough: { turn_id: turnId },
+    }],
+    client_metadata: {
+      "x-codex-turn-metadata": JSON.stringify({ request_kind: "turn", thread_id: threadId, turn_id: turnId }),
+    },
+    store: false,
+    stream: false,
+  };
+  if (reasoningEffort) body.reasoning = { effort: mapReasoningEffort(reasoningEffort) };
+  return {
+    url,
+    init: {
+      method: "POST",
+      headers: { authorization: `Bearer ${bearer}`, "content-type": "application/json" },
+      body: JSON.stringify(body),
+      signal,
+    },
+  };
+}
+
+export function mapReasoningEffort(reasoningEffort) {
+  return reasoningEffort === "low" ? "instant" : reasoningEffort;
+}
+
+export function extractResponseText(payload) {
+  if (typeof payload?.output_text === "string" && payload.output_text.trim()) return payload.output_text;
+  const output = Array.isArray(payload?.output) ? payload.output : [];
+  const finalOutput = output.filter((item) => item?.phase === "final_answer");
+  const items = (finalOutput.length ? finalOutput : output)
+    .flatMap((item) => Array.isArray(item?.content) ? item.content : [])
+    .map((item) => item?.text || item?.value || "")
+    .filter((value) => typeof value === "string" && value.trim());
+  const text = items.at(-1) || "";
+  return text.trim() ? text : null;
+}
+
+export async function runCgwTurn({ config, model, prompt, reasoningEffort, signal, bearer, fetchImpl = fetch }) {
+  const resolvedBearer = bearer || resolveBearer(config);
+  const timeoutSignal = AbortSignal.timeout(config.limits.timeoutMs);
+  const requestSignal = signal && AbortSignal.any ? AbortSignal.any([signal, timeoutSignal]) : signal || timeoutSignal;
+  const request = buildCgwResponseRequest({
+    baseUrl: config.cgw.baseUrl,
+    bearer: resolvedBearer,
+    model,
+    prompt,
+    reasoningEffort,
+    signal: requestSignal,
+  });
+
+  let response;
+  try {
+    response = await fetchImpl(request.url, request.init);
+  } catch (error) {
+    if (error?.name === "TimeoutError" || error?.name === "AbortError") {
+      throw errorWithState("CGW request timed out or was aborted", true, "cgw_request_aborted", 504);
+    }
+    throw errorWithState(error?.message || "CGW request failed", true, "cgw_request_failed", 502);
+  }
+
+  let rawText;
+  try {
+    rawText = await readResponseTextBounded(response, config.limits.maxOutputBytes);
+  } catch (error) {
+    if (error?.code === "cgw_response_too_large") throw error;
+    throw errorWithState(error?.message || "CGW response could not be read", true, "cgw_response_read_failed", 502);
+  }
+  let payload = null;
+  try { payload = rawText ? JSON.parse(rawText) : null; } catch {}
+  if (!response.ok) {
+    const detail = payload?.error?.message || payload?.error || rawText;
+    throw errorWithState(
+      `CGW HTTP ${response.status}${detail ? `: ${String(detail).slice(0, 240)}` : ""}`,
+      true,
+      "cgw_upstream_error",
+      response.status,
+    );
+  }
+
+  if (payload?.model !== model) {
+    throw errorWithState(
+      `CGW model mismatch: requested ${model}, received ${payload?.model || "<missing>"}`,
+      true,
+      "cgw_model_mismatch",
+      502,
+    );
+  }
+
+  const text = extractResponseText(payload);
+  if (!text) throw errorWithState("CGW returned no assistant text", true, "cgw_empty_response", 502);
+  return { text, dispatchStarted: true, model: payload.model };
+}
diff --git a/tools/cgw-codex-shim/compatibility.md b/tools/cgw-codex-shim/compatibility.md
